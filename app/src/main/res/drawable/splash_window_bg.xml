<?xml version="1.0" encoding="utf-8"?>
<!--
  Window background drawn by the OS before any Compose code runs.
  Device screen: 360dp wide × 772dp tall (720×1544px @ 320dpi / xhdpi).
  Icon: 250dp centred  →  left/right inset = (360-250)/2 = 55dp
                          top/bottom inset = (772-250)/2 = 261dp
  Uses ic_launcher_circle whose background is a perfect circle, so the icon
  renders as a circle on the lavender fill without needing Compose clip.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solid lavender fill -->
    <item>
        <color android:color="#FFF0E8FF" />
    </item>

    <!-- Icon PNG centered at its native xhdpi size (250dp) using gravity — no insets.
         Inset attributes on <item> are ignored on Vivo FunTouch OS; gravity on <bitmap>
         renders the image at natural resolution in the centre of the drawable bounds. -->
    <item>
        <bitmap
            android:src="@drawable/ic_splash_icon"
            android:gravity="center" />
    </item>

</layer-list>
